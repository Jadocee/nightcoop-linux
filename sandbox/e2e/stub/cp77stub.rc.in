// SPDX-License-Identifier: MIT
// Version resource of the stand-in: RED4ext checks ProductName and the fixed versions.
#include <winver.h>
1 VERSIONINFO
FILEVERSION @FV@
PRODUCTVERSION @PV@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "nightcoop-linux stand-in"
      VALUE "ProductName", "Cyberpunk 2077"
      VALUE "FileVersion", "@FVS@"
      VALUE "ProductVersion", "@PVS@"
      VALUE "OriginalFilename", "Cyberpunk2077.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
